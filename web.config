<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- Default document setup -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- PHP and static file handler -->
    <handlers accessPolicy="Read, Execute, Script">
      <clear />
      <add name="PHP via FastCGI" path="*.php" verb="*" modules="FastCgiModule" scriptProcessor="C:\PHP\php-cgi.exe" resourceType="File" />
      <add name="StaticFile" path="*" verb="*" modules="StaticFileModule,DefaultDocumentModule,DirectoryListingModule" resourceType="Either" requireAccess="Read" />
    </handlers>

    <!-- URL Rewrite Rules -->
    <rewrite>
      <rules>

        <!-- 1. Redirect HTTP GET to HTTPS (do not redirect POST — 301 drops the body/method) -->
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
            <add input="{REQUEST_METHOD}" pattern="^GET$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 2. Redirect www to non-www (307 preserves POST for form/API submissions) -->
        <rule name="Redirect WWW to non-WWW" enabled="true" stopProcessing="true">
          <match url="(.*)" ignoreCase="true" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.(.+)$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{C:1}/{R:1}" redirectType="Temporary" />
        </rule>

        <!-- 2b. Proxy API endpoints (/proxy/name -> /proxy/name.php) -->
        <rule name="Proxy API endpoints" stopProcessing="true">
          <match url="^proxy/([A-Za-z0-9_-]+)/?$" ignoreCase="true" />
          <action type="Rewrite" url="proxy/{R:1}.php" />
        </rule>

        <!-- 3. Redirect .php URLs to clean URLs -->
        <rule name="Redirect .php to clean URL" stopProcessing="true">
          <match url="(.*)\.php$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
            <add input="{R:1}" pattern="^proxy/" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 3b. REMOVE trailing slash for non-directories (fixes 404 on /contact-us/) -->
        <rule name="Remove trailing slash for non-directories" stopProcessing="true">
          <match url="(.*)/$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 4. Add trailing slash for directories -->
        <rule name="Add trailing slash for directories" stopProcessing="true">
          <match url="(.*[^/])$" />
          <conditions>
            <add input="{DOCUMENT_ROOT}\{R:1}" matchType="IsDirectory" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}/" redirectType="Permanent" />
        </rule>

        <!-- 5. Directory index support -->
        <rule name="Directory index support" stopProcessing="true">
          <match url="^(.*?)/?$" />
          <conditions>
            <add input="{DOCUMENT_ROOT}\{R:1}\index.php" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}/index.php" />
        </rule>

        <!-- 6. Rewrite clean URLs to .php (exclude static files) -->
        <rule name="Rewrite clean URL to .php" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{DOCUMENT_ROOT}\{R:1}.php" matchType="IsFile" />
            <!-- Exclude static assets and files like .apk -->
            <add input="{R:1}" pattern="^.*\.(jpg|jpeg|png|gif|css|js|pdf|svg|ico|webp|apk|zip|rar|txt|xml|json|mp4|webm|ogg)$" negate="true" />
          </conditions>
          <action type="Rewrite" url="{R:1}.php" />
        </rule>

        <!-- 7. Home page route -->
        <rule name="Home page route" stopProcessing="true">
          <match url="^home$" />
          <action type="Rewrite" url="index.php" />
        </rule>

        <!-- 8. Blog route -->
        <rule name="Blog route" stopProcessing="true">
          <match url="^blog/([A-Za-z0-9-]+)$" />
          <action type="Rewrite" url="cms-page.php?cms_path=blog/{R:1}" appendQueryString="true" />
        </rule>

        <!-- 9. View route -->
        <rule name="View route" stopProcessing="true">
          <match url="^view/([A-Za-z0-9-]+)$" />
          <action type="Rewrite" url="detail-view.php?slug={R:1}" />
        </rule>

        <!-- 10. CMS dynamic page when no local PHP file exists -->
        <rule name="CMS page route" stopProcessing="true">
          <match url="^([^/]+)/?$" />
          <conditions>
            <add input="{R:1}" pattern="^.*\.(jpg|jpeg|png|gif|css|js|pdf|svg|ico|webp|apk|zip|rar|txt|xml|json|mp4|webm|ogg)$" negate="true" />
            <add input="{DOCUMENT_ROOT}\{R:1}.php" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="cms-page.php?cms_path={R:1}" appendQueryString="true" />
        </rule>

      </rules>
    </rewrite>

    <!-- PX: IIS performance (compression, static cache, MIME) -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" dynamicCompressionBeforeCache="true" />
    <httpCompression directory="%SystemDrive%\inetpub\temp\IIS Temporary Compressed Files">
      <scheme name="gzip" dll="%Windir%\system32\inetsrv\gzip.dll" />
      <dynamicTypes>
        <add mimeType="text/*" enabled="true" />
        <add mimeType="message/*" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="application/json" enabled="true" />
        <add mimeType="application/xml" enabled="true" />
        <add mimeType="image/svg+xml" enabled="true" />
        <add mimeType="*/*" enabled="false" />
      </dynamicTypes>
      <staticTypes>
        <add mimeType="text/*" enabled="true" />
        <add mimeType="message/*" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="application/json" enabled="true" />
        <add mimeType="application/xml" enabled="true" />
        <add mimeType="image/svg+xml" enabled="true" />
        <add mimeType="*/*" enabled="false" />
      </staticTypes>
    </httpCompression>
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>